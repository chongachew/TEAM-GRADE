# Google Cloud Project Configuration
GCP_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE_ID=your-firebase-db-id

# Firestore Configuration
FIRESTORE_CREDENTIALS_PATH=credentials/service-account.json
FIRESTORE_COLLECTION_VIDEOS=videos

# Pipeline Configuration
FRAME_EXTRACTION_FPS=15
POSE_CONFIDENCE_THRESHOLD=0.7
OCR_CONFIDENCE_THRESHOLD=0.8
OCR_STOP_ON_CONFIDENCE=0.8

# Processing Configuration
MAX_FRAME_BATCH_SIZE=100
QUEUE_POLL_INTERVAL=5.0
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_BACKOFF=0.1

# Model Configuration
POSE_MODEL_COMPLEXITY=1
POSE_USE_FULL_BODY=true
JERSEY_OCR_USE_GPU=false

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
API_LOG_LEVEL=INFO

# UI Configuration
UI_HOST=127.0.0.1
UI_PORT=8080

# Video Processing
YOUTUBE_DOWNLOADER_PATH=youtube_downloader.py
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=600
VIDEO_MAX_RESOLUTION=720

# Storage Configuration
VIDEOS_BASE_PATH=videos/
FRAMES_BASE_PATH=extracted_frames/
TORSO_CROPS_BASE_PATH=torso_crops/
TEMP_PATH=/tmp

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/pipeline.log
LOG_MAX_SIZE_MB=100

# Feature Flags
ENABLE_GPU=false
ENABLE_ASYNC_PROCESSING=true
DEBUG_MODE=false

# Optional: Performance Tuning
THREAD_POOL_SIZE=4
BATCH_PROCESSING_ENABLED=true
