# TEAM-GRADE Ingestion API base URL
REACT_APP_API_BASE=http://localhost:8000

# The Bridge Athletics app - "Save to my profile" links here after a track is
# claimed. Neither service is deployed publicly yet, so this points at
# localhost in dev (mirrors NEXT_PUBLIC_TEAM_GRADE_APP_URL's documentation on
# the Bridge Athletics side). Both apps default to port 3000 - when running
# both locally at once, start one on a different port and update this value.
REACT_APP_BRIDGE_APP_URL=http://localhost:3000
