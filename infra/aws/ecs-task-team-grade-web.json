{
  "family": "team-grade-web",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::455646290581:role/bridge-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::455646290581:role/team-grade-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "team-grade-web",
      "image": "455646290581.dkr.ecr.us-east-1.amazonaws.com/team-grade-web:latest",
      "portMappings": [{ "containerPort": 3500, "protocol": "tcp" }],
      "essential": true,
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:3500/health || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/team-grade-web",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
