{
  "metadata": {
    "version": "1.0.0",
    "engine": "Trench Engine",
    "description": "Universal baseline configuration for all positions"
  },
  "bucketing": {
    "numeric": {
      "elite": { "min": 90, "max": 100 },
      "high": { "min": 75, "max": 89 },
      "average": { "min": 50, "max": 74 },
      "below_average": { "min": 25, "max": 49 },
      "poor": { "min": 0, "max": 24 }
    },
    "categorical": {
      "excellent": 95,
      "good": 80,
      "average": 60,
      "poor": 35,
      "very_poor": 15
    }
  },
  "aggregation": {
    "rep_to_play": "mean",
    "play_to_game": "mean",
    "game_to_season": "mean"
  },
  "output_schema": {
    "rep": ["position", "player_id", "time", "features", "traits"],
    "play": ["position", "player_id", "play_id", "rep_count", "trait_scores", "composite_score"],
    "game": ["position", "player_id", "game_id", "snaps", "trait_averages", "grade"],
    "season": ["position", "player_id", "season", "games", "trait_averages", "final_grade"]
  }
}
